{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "executed",
        "consumed",
        "execution_failed",
        "cancelled"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "ApprovalTicket": {
      "additionalProperties": false,
      "properties": {
        "action_hash": {
          "title": "Action Hash",
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "approval_id": {
          "title": "Approval Id",
          "type": "string"
        },
        "consumed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumed At"
        },
        "consumed_by_job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumed By Job Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decided_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided At"
        },
        "decision_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Reason"
        },
        "executed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executed At"
        },
        "executed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executed By"
        },
        "execution_contract_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Contract Hash"
        },
        "execution_error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Error Code"
        },
        "execution_status": {
          "$ref": "#/$defs/ExecutionStatus",
          "default": "not_executed"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "policy_hash": {
          "title": "Policy Hash",
          "type": "string"
        },
        "request_hash": {
          "title": "Request Hash",
          "type": "string"
        },
        "resume_claimed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resume Claimed At"
        },
        "resume_claimed_job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resume Claimed Job Id"
        },
        "resume_token_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resume Token Ref"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "snapshot": {
          "additionalProperties": true,
          "title": "Snapshot",
          "type": "object"
        },
        "snapshot_hash": {
          "title": "Snapshot Hash",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "target_kind": {
          "title": "Target Kind",
          "type": "string"
        },
        "target_ref": {
          "title": "Target Ref",
          "type": "string"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "workspace_id": {
          "default": "default",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "version",
        "approval_id",
        "run_id",
        "status",
        "target_kind",
        "target_ref",
        "action_hash",
        "policy_hash",
        "request_hash",
        "snapshot_hash",
        "expires_at",
        "idempotency_key"
      ],
      "title": "ApprovalTicket",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "not_executed",
        "executed",
        "execution_failed"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.0",
      "title": "Contract Version",
      "type": "string"
    },
    "pending": {
      "items": {
        "$ref": "#/$defs/ApprovalTicket"
      },
      "title": "Pending",
      "type": "array"
    }
  },
  "required": [
    "contract_version"
  ],
  "title": "ApprovalPendingPayloadContract",
  "type": "object"
}