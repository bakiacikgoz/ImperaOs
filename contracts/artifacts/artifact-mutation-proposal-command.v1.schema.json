{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "https://schemas.imperaos.local/artifacts/artifact-mutation-proposal-command.v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Artifactid",
      "type": "string"
    },
    "baseRevisionNumber": {
      "minimum": 1,
      "title": "Baserevisionnumber",
      "type": "integer"
    },
    "content": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Content",
      "type": "object"
    },
    "contextPurpose": {
      "enum": [
        "edit",
        "transform"
      ],
      "title": "Contextpurpose",
      "type": "string"
    },
    "contextRevisionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Contextrevisionid",
      "type": "string"
    },
    "contextSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contextsha256",
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Idempotencykey",
      "type": "string"
    },
    "mutationType": {
      "const": "replace_content",
      "title": "Mutationtype",
      "type": "string"
    },
    "proposalId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposalid"
    },
    "selectionSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selectionsha256",
      "type": "string"
    },
    "sourceSessionId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sourcesessionid"
    },
    "sourceTurnId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sourceturnid"
    },
    "summary": {
      "default": "",
      "maxLength": 500,
      "title": "Summary",
      "type": "string"
    },
    "targetSelection": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Targetselection",
      "type": "object"
    }
  },
  "required": [
    "artifactId",
    "baseRevisionNumber",
    "mutationType",
    "content",
    "idempotencyKey",
    "contextSha256",
    "selectionSha256",
    "contextRevisionId",
    "contextPurpose",
    "targetSelection"
  ],
  "title": "ProposeArtifactMutationCommand",
  "type": "object",
  "x-imperaos-contract": "artifact-mutation-proposal-command.v1"
}