{
  "$id": "https://schemas.imperaos.local/artifacts/artifact-export-result.v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Artifactid",
      "type": "string"
    },
    "basename": {
      "title": "Basename",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "updated",
        "idempotent_replay"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "exportId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Exportid",
      "type": "string"
    },
    "format": {
      "enum": [
        "source",
        "txt",
        "json",
        "submission-json",
        "markdown",
        "html",
        "svg",
        "png",
        "csv",
        "xlsx",
        "pptx"
      ],
      "title": "Format",
      "type": "string"
    },
    "reasonCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reasoncode"
    },
    "revisionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Revisionid",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "sizeBytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sizebytes"
    },
    "status": {
      "enum": [
        "pending",
        "completed",
        "cancelled",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "exportId",
    "artifactId",
    "revisionId",
    "format",
    "status",
    "basename",
    "disposition"
  ],
  "title": "ArtifactExportResult",
  "type": "object",
  "x-imperaos-contract": "artifact-export-result.v1"
}