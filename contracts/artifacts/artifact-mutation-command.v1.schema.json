{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "https://schemas.imperaos.local/artifacts/artifact-mutation-command.v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Artifactid",
      "type": "string"
    },
    "changeSummary": {
      "default": "",
      "maxLength": 500,
      "title": "Changesummary",
      "type": "string"
    },
    "content": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Content",
      "type": "object"
    },
    "expectedRevisionNumber": {
      "minimum": 1,
      "title": "Expectedrevisionnumber",
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Idempotencykey",
      "type": "string"
    },
    "mutationType": {
      "const": "replace_content",
      "title": "Mutationtype",
      "type": "string"
    }
  },
  "required": [
    "artifactId",
    "expectedRevisionNumber",
    "mutationType",
    "content",
    "idempotencyKey"
  ],
  "title": "MutateArtifactCommand",
  "type": "object",
  "x-imperaos-contract": "artifact-mutation-command.v1"
}