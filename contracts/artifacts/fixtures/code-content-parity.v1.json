{
  "contractVersion": 1,
  "cases": [
    {
      "id": "python-lf",
      "expectedValid": true,
      "content": {
        "kind": "code",
        "schemaVersion": 2,
        "filename": "main.py",
        "language": "python",
        "text": "print('display only')\n",
        "lineEnding": "lf",
        "executionPolicy": "deny"
      }
    },
    {
      "id": "powershell-crlf",
      "expectedValid": true,
      "content": {
        "kind": "code",
        "schemaVersion": 2,
        "filename": "setup.ps1",
        "language": "powershell",
        "text": "Write-Output 'safe'\r\n",
        "lineEnding": "crlf",
        "executionPolicy": "deny"
      }
    },
    {
      "id": "unknown-language",
      "expectedValid": false,
      "content": {
        "kind": "code",
        "schemaVersion": 2,
        "filename": "main.ts",
