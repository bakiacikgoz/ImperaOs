        "lineEnding": "lf",
        "executionPolicy": "deny"
      }
    },
    {
      "id": "unicode-17-format-control",
      "expectedValid": false,
      "content": {
        "kind": "code",
        "schemaVersion": 2,
        "filename": "safe\ud80d\udc39.py",
