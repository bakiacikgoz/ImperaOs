        "text": "pass\n",
        "lineEnding": "lf",
        "executionPolicy": "deny"
      }
    },
    {
      "id": "bidi-control",
      "expectedValid": false,
      "content": {
        "kind": "code",
        "schemaVersion": 2,
        "filename": "safe\u202Etxt.py",
