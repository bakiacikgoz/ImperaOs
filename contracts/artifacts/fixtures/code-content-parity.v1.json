        "text": "export {};\n",
        "lineEnding": "lf",
        "executionPolicy": "deny"
      }
    },
    {
      "id": "reserved-device-name",
      "expectedValid": false,
      "content": {
        "kind": "code",
        "schemaVersion": 2,
