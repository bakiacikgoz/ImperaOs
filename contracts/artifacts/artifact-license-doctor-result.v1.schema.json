{
  "$defs": {
    "ArtifactLicenseCapability": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "artifact-license-capability/v1",
          "default": "artifact-license-capability/v1",
          "title": "Contractversion",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "spreadsheet",
            "canvas"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reasonCode": {
          "enum": [
            "ARTIFACT_LICENSE_ENABLED",
            "ARTIFACT_LICENSE_FEATURE_DISABLED",
            "ARTIFACT_LICENSE_EVIDENCE_MISSING",
            "ARTIFACT_LICENSE_EVIDENCE_INVALID",
            "ARTIFACT_LICENSE_EXPIRED",
            "ARTIFACT_LICENSE_MODE_FORBIDDEN",
            "ARTIFACT_LICENSE_VERSION_MISMATCH",
            "ARTIFACT_LICENSE_TARGET_MISMATCH",
            "ARTIFACT_LICENSE_OFFLINE_UNVERIFIED",
            "ARTIFACT_LICENSE_ACTIVATION_UNSUPPORTED",
            "ARTIFACT_LICENSE_PACKAGE_MISSING"
          ],
          "title": "Reasoncode",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "enabled",
        "reasonCode"
      ],
      "title": "ArtifactLicenseCapability",
      "type": "object"
    }
  },
  "$id": "https://schemas.imperaos.local/artifacts/artifact-license-doctor-result.v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "buildTarget": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Buildtarget",
      "type": "string"
    },
    "capability": {
      "$ref": "#/$defs/ArtifactLicenseCapability"
    },
    "checkedPackages": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Checkedpackages",
      "type": "object"
    },
    "contractVersion": {
      "const": "artifact-license-doctor-result/v1",
      "default": "artifact-license-doctor-result/v1",
      "title": "Contractversion",
      "type": "string"
    },
    "evidenceId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidenceid"
    },
    "profile": {
      "const": "production",
      "default": "production",
      "title": "Profile",
      "type": "string"
    }
  },
  "required": [
    "capability",
    "buildTarget",
    "checkedPackages"
  ],
  "title": "ArtifactLicenseDoctorResult",
  "type": "object",
  "x-imperaos-contract": "artifact-license-doctor-result.v1"
}