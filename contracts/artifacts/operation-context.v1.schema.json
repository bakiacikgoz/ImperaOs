{
  "$defs": {
    "PrincipalType": {
      "enum": [
        "user",
        "assistant",
        "system",
        "import"
      ],
      "title": "PrincipalType",
      "type": "string"
    }
  },
  "$id": "https://schemas.imperaos.local/artifacts/operation-context.v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "principalId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Principalid",
      "type": "string"
    },
    "principalType": {
      "$ref": "#/$defs/PrincipalType"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Requestid",
      "type": "string"
    },
    "roles": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Roles",
      "type": "array"
    },
    "traceId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceid"
    },
    "workspaceId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Workspaceid",
      "type": "string"
    }
  },
  "required": [
    "workspaceId",
    "principalType",
    "principalId",
    "requestId"
  ],
  "title": "OperationContext",
  "type": "object",
  "x-imperaos-contract": "operation-context.v1"
}